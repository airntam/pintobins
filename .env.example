# The address you type into your browser, exactly (scheme, host and port). QR codes and
# sign-in use it. Home install: http://localhost:3000. Dev: http://localhost:5173.
# Public deploy: https://your.domain
PUBLIC_BASE_URL=http://localhost:3000
# Internal PocketBase URL (compose network). Dev without docker: http://127.0.0.1:8090
PB_URL=http://pocketbase:8090
# First-boot user (created if no users exist)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
# Only needed with the `tunnel` profile (Portainer + Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
# Host port for the web service (compose). Coolify ignores this.
WEB_PORT=3000
# Only for docker-compose.ghcr.yml (prebuilt images): the GitHub user that publishes them
GHCR_OWNER=airntam
